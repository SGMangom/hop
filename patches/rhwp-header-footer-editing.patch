+    /// 머리말/꼬리말 내부 선택 영역의 줄별 사각형을 계산한다.
+    pub fn get_selection_rects_in_header_footer_native(
+        &self,
+        page_num: u32,
+        is_header: bool,
+        start_para_idx: usize,
+        start_char_offset: usize,
+        end_para_idx: usize,
+        end_char_offset: usize,
+    ) -> Result<String, HwpError> {
+        use crate::renderer::layout::compute_char_positions;
+        use crate::renderer::render_tree::{RenderNode, RenderNodeType};
+
+        let tree = self.build_page_tree(page_num)?;
+        let Some(hf_node) = tree.root.children.iter().find(|child| {
+            if is_header {
+                matches!(child.node_type, RenderNodeType::Header)
+            } else {
+                matches!(child.node_type, RenderNodeType::Footer)
+            }
+        }) else {
+            return Ok("[]".to_string());
+        };
+
+        #[derive(Clone)]
+        struct Run {
+            para_idx: usize,
+            char_start: usize,
+            char_count: usize,
+            positions: Vec<f64>,
+            x: f64,
+            y: f64,
+            width: f64,
+            height: f64,
+        }
+        fn collect(node: &RenderNode, runs: &mut Vec<Run>) {
+            if let RenderNodeType::TextRun(ref tr) = node.node_type {
+                if let (Some(marker_para), Some(char_start)) = (tr.para_index, tr.char_start) {
+                    if marker_para >= usize::MAX - 1000 {
+                        runs.push(Run {
+                            para_idx: usize::MAX - marker_para,
+                            char_start,
+                            char_count: tr.text.chars().count(),
+                            positions: compute_char_positions(tr.display_or_text(), &tr.style),
+                            x: node.bbox.x,
+                            y: node.bbox.y,
+                            width: node.bbox.width,
+                            height: node.bbox.height,
+                        });
+                    }
+                }
+            }
+            for child in &node.children {
+                collect(child, runs);
+            }
+        }
+        fn cmp_pos(a: (usize, usize), b: (usize, usize)) -> std::cmp::Ordering {
+            a.0.cmp(&b.0).then_with(|| a.1.cmp(&b.1))
+        }
+        fn x_at(run: &Run, model_offset: usize) -> f64 {
+            if model_offset <= run.char_start {
+                return run.x;
+            }
+            let local_model = (model_offset - run.char_start).min(run.char_count);
+            let display_len = run.positions.len().saturating_sub(1);
+            let display_idx = if run.char_count == 0 || display_len == run.char_count {
+                local_model
+            } else {
+                (local_model * display_len + run.char_count / 2) / run.char_count
+            };
+            run.positions
+                .get(display_idx)
+                .copied()
+                .map(|dx| run.x + dx)
+                .unwrap_or(run.x + run.width)
+        }
+
+        let (start, end) = if cmp_pos(
+            (start_para_idx, start_char_offset),
+            (end_para_idx, end_char_offset),
+        )
+        .is_gt()
+        {
+            (
+                (end_para_idx, end_char_offset),
+                (start_para_idx, start_char_offset),
+            )
+        } else {
+            (
+                (start_para_idx, start_char_offset),
+                (end_para_idx, end_char_offset),
+            )
+        };
+        if start == end {
+            return Ok("[]".to_string());
+        }
+
+        let mut runs = Vec::new();
+        collect(hf_node, &mut runs);
+        runs.sort_by(|a, b| {
+            a.para_idx
+                .cmp(&b.para_idx)
+                .then_with(|| a.y.partial_cmp(&b.y).unwrap_or(std::cmp::Ordering::Equal))
+                .then_with(|| a.x.partial_cmp(&b.x).unwrap_or(std::cmp::Ordering::Equal))
+        });
+
+        let mut rects = Vec::new();
+        for run in runs {
+            let run_start = (run.para_idx, run.char_start);
+            let run_end = (run.para_idx, run.char_start + run.char_count);
+            if cmp_pos(run_end, start) != std::cmp::Ordering::Greater
+                || cmp_pos(run_start, end) != std::cmp::Ordering::Less
+            {
+                continue;
+            }
+            let sel_start = if run.para_idx == start.0 {
+                start.1.max(run.char_start)
+            } else {
+                run.char_start
+            };
+            let sel_end = if run.para_idx == end.0 {
+                end.1.min(run.char_start + run.char_count)
+            } else {
+                run.char_start + run.char_count
+            };
+            if sel_end <= sel_start {
+                continue;
+            }
+            let x1 = x_at(&run, sel_start);
+            let x2 = x_at(&run, sel_end);
+            rects.push(format!(
+                "{{\"pageIndex\":{},\"x\":{:.2},\"y\":{:.2},\"width\":{:.2},\"height\":{:.2}}}",
+                page_num,
+                x1.min(x2),
+                run.y,
+                (x2 - x1).abs().max(1.0),
+                run.height,
+            ));
+        }
+        Ok(format!("[{}]", rects.join(",")))
     }

