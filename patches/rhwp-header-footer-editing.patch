+    /// 머리말/꼬리말 문단의 실제 선택 범위에 글자 서식을 적용한다.
+    /// 선택 없는 캐럿의 대기 서식은 Studio host가 보관하고, 텍스트가 삽입된 직후
+    /// 이 API로 삽입 범위에 적용한다. 이로써 본문용 pending shape가 HF 밖으로 새지 않는다.
+    pub fn apply_char_format_in_hf_native(
+        &mut self,
+        section_idx: usize,
+        is_header: bool,
+        apply_to: u8,
+        hf_para_idx: usize,
+        start_offset: usize,
+        end_offset: usize,
+        props_json: &str,
+    ) -> Result<String, HwpError> {
+        if section_idx >= self.document.sections.len() {
+            return Err(HwpError::RenderError(format!(
+                "구역 {} 범위 초과",
+                section_idx
+            )));
+        }
+        if start_offset >= end_offset {
+            return Ok("{\"ok\":true}".to_string());
+        }
+
+        let mods = parse_char_shape_mods(props_json);
+        let (base_id, text_len) = {
+            let para = self
+                .get_hf_paragraph_ref(section_idx, is_header, apply_to, hf_para_idx)
+                .ok_or_else(|| {
+                    HwpError::RenderError("머리말/꼬리말 문단을 찾을 수 없습니다".to_string())
+                })?;
+            (
+                para.char_shape_id_at(start_offset).unwrap_or(0),
+                para.text.chars().count(),
+            )
+        };
+        let start = start_offset.min(text_len);
+        let end = end_offset.min(text_len);
+        if start >= end {
+            return Ok("{\"ok\":true}".to_string());
+        }
+
+        let new_id = self.document.find_or_create_char_shape(base_id, &mods);
+        self.get_hf_paragraph_mut(section_idx, is_header, apply_to, hf_para_idx)?
+            .apply_char_shape_range(start, end, new_id);
+
+        if char_shape_mods_affect_text_flow(&mods) {
+            self.reflow_hf_paragraph(section_idx, is_header, apply_to, hf_para_idx);
+        }
+        self.document.sections[section_idx].raw_stream = None;
+        self.rebuild_section(section_idx);
+        self.event_log.push(DocumentEvent::CharFormatChanged {
+            section: section_idx,
+            para: hf_para_idx,
+            start,
+            end,
+        });
+        Ok("{\"ok\":true}".to_string())
     }

