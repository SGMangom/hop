+    /// 머리말/꼬리말 문단의 현재 글자 속성을 조회한다.
+    pub fn get_char_properties_in_hf_native(
+        &self,
+        section_idx: usize,
+        is_header: bool,
+        apply_to: u8,
+        hf_para_idx: usize,
+        char_offset: usize,
+    ) -> Result<String, HwpError> {
+        let para = self
+            .get_hf_paragraph_ref(section_idx, is_header, apply_to, hf_para_idx)
+            .ok_or_else(|| {
+                HwpError::RenderError("머리말/꼬리말 문단을 찾을 수 없습니다".to_string())
+            })?;
