+    #[test]
+    fn hidden_comment_serializes_in_order_and_roundtrips_nested_text() {
+        use crate::model::control::{Control, HiddenComment};
+        use crate::parser::hwpx::section::parse_hwpx_section;
+
+        let mut inner = Paragraph::default();
+        inner.text = "숨은 설명 본문".to_string();
+
+        let mut para = Paragraph::default();
+        para.controls = vec![
+            Control::Table(Box::default()),
+            Control::HiddenComment(Box::new(HiddenComment {
+                paragraphs: vec![inner],
+            })),
+        ];
+
+        let (doc, section) = make_doc_with_paragraph(para);
+        let mut ctx = SerializeContext::collect_from_document(&doc);
+        let xml = String::from_utf8(write_section(&section, &doc, 0, &mut ctx).unwrap()).unwrap();
+
+        let table_pos = xml.find("<hp:tbl").expect("table XML");
+        let comment_pos = xml.find("<hp:hiddenComment>").expect("hiddenComment XML");
+        assert!(table_pos < comment_pos, "zero-width hiddenComment가 원본 control 순서를 보존해야 함");
+        assert!(xml.contains("숨은 설명 본문"));
+
+        let reparsed = parse_hwpx_section(&xml).expect("section reparse");
+        let controls = &reparsed.paragraphs[0].controls;
+        let comment = controls
+            .iter()
+            .find_map(|control| match control {
+                Control::HiddenComment(comment) => Some(comment),
+                _ => None,
+            })
+            .expect("hiddenComment control survives");
+        assert_eq!(comment.paragraphs.len(), 1);
+        assert_eq!(comment.paragraphs[0].text, "숨은 설명 본문");
+    }
