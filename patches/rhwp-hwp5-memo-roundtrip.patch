 #[test]
+fn hop_hwpx_memo_survives_hwp_and_hwpx_roundtrips() {
+    use crate::model::control::{Control, FieldType};
+
+    let bytes = std::fs::read("samples/hwpx/aift.hwpx").expect("aift HWPX fixture");
+    let mut source = HwpDocument::from_bytes(&bytes).expect("HWPX parse");
+
+    // HWP5 LIST_HEADER의 text-direction bit 왕복도 함께 검증한다. aift의 첫 MEMO를
+    // 세로쓰기로 만들어 HWPX -> HWP -> reopen -> HWPX 경로가 방향을 보존해야 한다.
+    let mut verticalized = false;
+    for section in &mut source.document.sections {
+        for paragraph in &mut section.paragraphs {
+            for control in &mut paragraph.controls {
+                if let Control::Field(field) = control {
+                    if field.field_type == FieldType::Memo && !verticalized {
+                        field.memo_text_direction = Some("VERTICAL".to_string());
+                        verticalized = true;
+                    }
+                }
+            }
+        }
+    }
+    assert!(verticalized, "aift fixture must contain a MEMO field");
+    let expected = memo_roundtrip_signature(&source);
+    assert_eq!(expected.len(), 2, "aift MEMO count");
+    assert!(expected.iter().all(|memo| !memo.4.is_empty()));
+    let paragraph_counts: Vec<usize> = source
+        .document
+        .sections
+        .iter()
+        .map(|section| section.paragraphs.len())
+        .collect();
+
+    let hwp = source
+        .export_hwp_with_adapter_snapshot()
+        .expect("HWPX MEMO -> HWP save");
+    let hwp_reopened = HwpDocument::from_bytes(&hwp).expect("MEMO HWP reopen");
+    assert_eq!(memo_roundtrip_signature(&hwp_reopened), expected);
+    assert_eq!(
+        hwp_reopened
+            .document
+            .sections
+            .iter()
+            .map(|section| section.paragraphs.len())
+            .collect::<Vec<_>>(),
+        paragraph_counts,
+        "MEMO_LIST synthetic host paragraph must not leak into body"
+    );
+
+    let hwp_again = hwp_reopened
+        .export_hwp_with_adapter_snapshot()
+        .expect("reopened MEMO -> HWP resave");
+    let hwp_reopened_again = HwpDocument::from_bytes(&hwp_again).expect("MEMO HWP rereopen");
+    assert_eq!(memo_roundtrip_signature(&hwp_reopened_again), expected);
+
+    let hwpx = hwp_reopened
+        .export_hwpx_native()
+        .expect("reopened MEMO -> HWPX save");
+    let hwpx_reopened = HwpDocument::from_bytes(&hwpx).expect("MEMO HWPX reopen");
+    assert_eq!(memo_roundtrip_signature(&hwpx_reopened), expected);
+}
