+fn memo_roundtrip_signature(
+    doc: &HwpDocument,
+) -> Vec<(usize, u32, u32, Option<String>, Vec<String>)> {
+    use crate::model::control::{Control, FieldType};
+
+    let mut out = Vec::new();
+    for (section_idx, section) in doc.document.sections.iter().enumerate() {
+        for paragraph in &section.paragraphs {
+            for control in &paragraph.controls {
+                if let Control::Field(field) = control {
+                    if field.field_type == FieldType::Memo {
+                        out.push((
+                            section_idx,
+                            field.memo_index,
+                            field.ctrl_id,
+                            field.memo_text_direction.clone(),
+                            field
+                                .memo_paragraphs
+                                .iter()
+                                .map(|paragraph| paragraph.text.clone())
+                                .collect(),
+                        ));
+                    }
+                }
+            }
+        }
+    }
+    out.sort_by_key(|entry| (entry.0, entry.1));
+    out
+}
