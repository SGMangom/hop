+#[derive(Debug)]
+struct Hwp5MemoTail {
+    memo_index: u32,
+    paragraphs: Vec<Paragraph>,
+    text_direction: Option<String>,
+}
+
+/// HWP5 메모 tail은 synthetic root paragraph 아래
+/// `MEMO_LIST(level+1) -> LIST_HEADER(level+1) -> PARA_HEADER(level+1...)` 형태다.
+/// serializer/body_text.rs의 역으로, 한 root 안의 메모 여러 건을 각각 복원한다.
+fn parse_hwp5_memo_tail(records: &[Record], base_level: u16) -> Vec<Hwp5MemoTail> {
+    let memo_level = base_level.saturating_add(1);
+    let mut memos = Vec::new();
+    let mut idx = 1;
+    while idx < records.len() {
+        if records[idx].tag_id != tags::HWPTAG_MEMO_LIST || records[idx].level != memo_level {
+            idx += 1;
+            continue;
+        }
+        if records[idx].data.len() < 4 {
+            idx += 1;
+            continue;
+        }
+        let memo_index = u32::from_le_bytes([
+            records[idx].data[0],
+            records[idx].data[1],
+            records[idx].data[2],
+            records[idx].data[3],
+        ]);
+
+        let Some(list_header_idx) = (idx + 1..records.len()).find(|&candidate| {
+            let record = &records[candidate];
+            if record.level < memo_level {
+                return false;
+            }
+            record.level == memo_level && record.tag_id == tags::HWPTAG_LIST_HEADER
+        }) else {
+            idx += 1;
+            continue;
+        };
+        if records[idx + 1..list_header_idx]
+            .iter()
+            .any(|record| record.level == memo_level && record.tag_id == tags::HWPTAG_MEMO_LIST)
+        {
+            idx = list_header_idx;
+            continue;
+        }
+
+        let list_header = &records[list_header_idx];
+        // MEMO LIST_HEADER: paraCount(i32) + list_attr/property(u32) + reserved[8].
+        // generic HWP5 list_attr의 bits 16..18은 text direction이다(셀 LIST_HEADER와 동일).
+        let list_attr = if list_header.data.len() >= 8 {
+            u32::from_le_bytes([
+                list_header.data[4],
+                list_header.data[5],
+                list_header.data[6],
+                list_header.data[7],
+            ])
+        } else {
+            0
+        };
+        let text_direction = match (list_attr >> 16) & 0x07 {
+            1 => Some("VERTICAL".to_string()),
+            _ => None,
+        };
+
+        // MEMO paragraph는 LIST_HEADER와 같은 level에 PARA_HEADER가 오고 그 자식만
+        // 더 깊다. 선언된 paraCount만큼 정확히 소비해야 뒤의 다른 MEMO_LIST/바탕쪽을
+        // 삼키지 않는다.
+        let declared_paragraphs = if list_header.data.len() >= 4 {
+            i32::from_le_bytes([
+                list_header.data[0],
+                list_header.data[1],
+                list_header.data[2],
+                list_header.data[3],
+            ])
+            .max(0) as usize
+        } else {
+            0
+        };
+        let para_start = list_header_idx + 1;
+        let mut para_end = para_start;
+        let mut consumed = 0usize;
+        while para_end < records.len() && consumed < declared_paragraphs {
+            if records[para_end].tag_id == tags::HWPTAG_PARA_HEADER
+                && records[para_end].level == memo_level
+            {
+                consumed += 1;
+                para_end += 1;
+                while para_end < records.len() && records[para_end].level > memo_level {
+                    para_end += 1;
+                }
+            } else {
+                break;
+            }
+        }
+        memos.push(Hwp5MemoTail {
+            memo_index,
+            paragraphs: parse_paragraph_list(&records[para_start..para_end]),
+            text_direction,
+        });
+        idx = para_end.max(list_header_idx + 1);
+    }
+    memos
+}
+
+/// HWPX MEMO를 HWP5로 내릴 때 serializer는 `%unk` + properties bit15를 쓰고
+/// memo_index로 MEMO_LIST tail과 연결한다. 재파싱 시 이 정확한 legacy 표현만 native
+/// Field(MEMO)로 canonicalize하여 일반 Unknown 필드를 오인하지 않는다.
+fn attach_hwp5_memo(section: &mut Section, memo: Hwp5MemoTail) -> bool {
+    for paragraph in &mut section.paragraphs {
+        for control in &mut paragraph.controls {
+            let Control::Field(field) = control else {
+                continue;
+            };
+            let canonical_memo = field.field_type == FieldType::Memo;
+            let lowered_memo = field.field_type == FieldType::Unknown
+                && field.ctrl_id == tags::FIELD_UNKNOWN
+                && field.properties & (1 << 15) != 0;
+            if field.memo_index != memo.memo_index || (!canonical_memo && !lowered_memo) {
+                continue;
+            }
+            field.field_type = FieldType::Memo;
+            field.ctrl_id = tags::FIELD_MEMO;
+            field.memo_paragraphs = memo.paragraphs;
+            field.memo_text_direction = memo.text_direction;
+            return true;
+        }
+    }
+    false
+}
+
+/// 확장 바탕쪽 탐색에서 MEMO_LIST 직후의 LIST_HEADER를 master-page header로
+/// 오인하지 않기 위한 판정. 직전 동일/상위 level 레코드가 MEMO_LIST일 때만 제외한다.
+fn is_hwp5_memo_list_header(records: &[Record], list_header_idx: usize) -> bool {
+    let Some(header) = records.get(list_header_idx) else {
+        return false;
+    };
+    if header.tag_id != tags::HWPTAG_LIST_HEADER {
+        return false;
+    }
+    records[..list_header_idx]
+        .iter()
+        .rposition(|record| record.level <= header.level)
+        .is_some_and(|idx| {
+            records[idx].level == header.level && records[idx].tag_id == tags::HWPTAG_MEMO_LIST
+        })
+}
