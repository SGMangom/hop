+fn diff_equation_content(
+    a: &crate::model::control::Equation,
+    b: &crate::model::control::Equation,
+) -> Vec<String> {
+    use crate::model::control::EQUATION_LINE_MODE_BIT;
+
+    let mut parts = Vec::new();
+    if a.script != b.script {
+        parts.push(format!(
+            "script: expected={:?} actual={:?}",
+            a.script, b.script
+        ));
+    }
+    if a.font_size != b.font_size {
+        parts.push(format!(
+            "font_size: expected={} actual={}",
+            a.font_size, b.font_size
+        ));
+    }
+    if a.color != b.color {
+        parts.push(format!(
+            "color: expected=0x{:08X} actual=0x{:08X}",
+            a.color, b.color
+        ));
+    }
+    if a.baseline != b.baseline {
+        parts.push(format!(
+            "baseline: expected={} actual={}",
+            a.baseline, b.baseline
+        ));
+    }
+
+    // HWPX has a direct representation only for bit 0 (lineMode). Split the comparison so
+    // same-format HWP5 roundtrips still verify every preserved bit while cross-format callers
+    // can discard only the representation-specific remainder without hiding lineMode loss.
+    let attr_line_a = a.attr & EQUATION_LINE_MODE_BIT;
+    let attr_line_b = b.attr & EQUATION_LINE_MODE_BIT;
+    if attr_line_a != attr_line_b {
+        parts.push(format!(
+            "attr.line_mode: expected={} actual={}",
+            attr_line_a != 0,
+            attr_line_b != 0
+        ));
+    }
+    let attr_extra_a = a.attr & !EQUATION_LINE_MODE_BIT;
+    let attr_extra_b = b.attr & !EQUATION_LINE_MODE_BIT;
+    if attr_extra_a != attr_extra_b {
+        parts.push(format!(
+            "attr.extra_bits: expected=0x{:08X} actual=0x{:08X}",
+            attr_extra_a, attr_extra_b
+        ));
+    }
+
+    let eqedit_line_a = a.eqedit & EQUATION_LINE_MODE_BIT;
+    let eqedit_line_b = b.eqedit & EQUATION_LINE_MODE_BIT;
+    if eqedit_line_a != eqedit_line_b {
+        parts.push(format!(
+            "eqedit.line_mode: expected={} actual={}",
+            eqedit_line_a != 0,
+            eqedit_line_b != 0
+        ));
+    }
+    let eqedit_extra_a = a.eqedit & !EQUATION_LINE_MODE_BIT;
+    let eqedit_extra_b = b.eqedit & !EQUATION_LINE_MODE_BIT;
+    if eqedit_extra_a != eqedit_extra_b {
+        parts.push(format!(
+            "eqedit.extra_bits: expected=0x{:08X} actual=0x{:08X}",
+            eqedit_extra_a, eqedit_extra_b
+        ));
+    }
+
+    if a.font_name != b.font_name {
+        parts.push(format!(
+            "font_name: expected={:?} actual={:?}",
+            a.font_name, b.font_name
+        ));
+    }
+    if a.version_info != b.version_info {
+        parts.push(format!(
+            "version_info: expected={:?} actual={:?}",
+            a.version_info, b.version_info
+        ));
     }
+    parts
 }

+fn diff_field_content(
+    a: &crate::model::control::Field,
+    b: &crate::model::control::Field,
+) -> Vec<String> {
+    // Only these two bits have a direct HWPX fieldBegin representation (`editable`, `dirty`).
+    // Keep the remaining bits as a separate same-format gate so the cross-format filter can
+    // discard only representation noise rather than the whole properties comparison.
+    const HWPX_PROPERTY_MASK: u32 = 1 | (1 << 15);
+
+    let mut parts = Vec::new();
+    if a.field_type != b.field_type {
+        parts.push(format!(
+            "field_type: expected={:?} actual={:?}",
+            a.field_type, b.field_type
+        ));
+    }
+    if a.command != b.command {
+        parts.push(format!(
+            "command: expected={:?} actual={:?}",
+            a.command, b.command
+        ));
+    }
+    let properties_semantic_a = a.properties & HWPX_PROPERTY_MASK;
+    let properties_semantic_b = b.properties & HWPX_PROPERTY_MASK;
+    if properties_semantic_a != properties_semantic_b {
+        parts.push(format!(
+            "properties.semantic: expected=0x{:08X} actual=0x{:08X}",
+            properties_semantic_a, properties_semantic_b
+        ));
+    }
+    let properties_extra_a = a.properties & !HWPX_PROPERTY_MASK;
+    let properties_extra_b = b.properties & !HWPX_PROPERTY_MASK;
+    if properties_extra_a != properties_extra_b {
+        parts.push(format!(
+            "properties.extra_bits: expected=0x{:08X} actual=0x{:08X}",
+            properties_extra_a, properties_extra_b
+        ));
+    }
+    if a.extra_properties != b.extra_properties {
+        parts.push(format!(
+            "extra_properties: expected=0x{:02X} actual=0x{:02X}",
+            a.extra_properties, b.extra_properties
+        ));
+    }
+    if a.field_id != b.field_id {
+        parts.push(format!(
+            "field_id: expected={} actual={}",
+            a.field_id, b.field_id
+        ));
+    }
+    if a.ctrl_id != b.ctrl_id {
+        parts.push(format!(
+            "ctrl_id: expected=0x{:08X} actual=0x{:08X}",
+            a.ctrl_id, b.ctrl_id
+        ));
+    }
+    if a.instance_id != b.instance_id {
+        parts.push(format!(
+            "instance_id: expected={:?} actual={:?}",
+            a.instance_id, b.instance_id
+        ));
+    }
+    if a.ctrl_data_name != b.ctrl_data_name {
+        parts.push(format!(
+            "ctrl_data_name: expected={:?} actual={:?}",
+            a.ctrl_data_name, b.ctrl_data_name
+        ));
+    }
+    if a.memo_index != b.memo_index {
+        parts.push(format!(
+            "memo_index: expected={} actual={}",
+            a.memo_index, b.memo_index
+        ));
+    }
+    if a.memo_text_direction != b.memo_text_direction {
+        parts.push(format!(
+            "memo_text_direction: expected={:?} actual={:?}",
+            a.memo_text_direction, b.memo_text_direction
+        ));
+    }
+    if a.parameters != b.parameters {
+        parts.push(format!(
+            "parameters.semantic: expected={:?} actual={:?}",
+            a.parameters, b.parameters
+        ));
+    }
+    parts
+}
