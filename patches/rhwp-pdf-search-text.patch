@@ -30,6 +30,52 @@ fn test_svg_draw_text() {
     assert!(output.contains("font-weight=\"bold\""));
 }

+#[test]
+fn pdf_text_surface_groups_plain_run_without_changing_screen_default() {
+    let style = TextStyle {
+        font_size: 16.0,
+        bold: true,
+        ..Default::default()
+    };
+
+    let mut screen = SvgRenderer::new();
+    screen.begin_page(800.0, 600.0);
+    screen.draw_text("한/글 시작", 10.0, 20.0, &style);
+    assert!(screen.output().matches("<text ").count() > 1);
+
+    let mut pdf = SvgRenderer::new();
+    pdf.group_text_for_pdf = true;
+    pdf.begin_page(800.0, 600.0);
+    pdf.draw_text("한/글 시작", 10.0, 20.0, &style);
+    let output = pdf.output();
+    assert_eq!(output.matches("<text ").count(), 1);
+    assert!(output.contains(">한/글 시작</text>"));
+    assert!(output.contains("lengthAdjust=\"spacingAndGlyphs\""));
+}
+
+#[test]
+fn pdf_text_surface_keeps_middle_dot_special_rendering() {
+    let mut renderer = SvgRenderer::new();
+    renderer.group_text_for_pdf = true;
+    renderer.begin_page(800.0, 600.0);
+    renderer.draw_text("가·나", 10.0, 20.0, &TextStyle::default());
+    let output = renderer.output();
+    assert!(output.contains("<circle"));
+    assert!(!output.contains(">가·나</text>"));
+}
+
+#[test]
+fn pdf_text_surface_groups_text_on_both_sides_of_tab() {
+    let mut renderer = SvgRenderer::new();
+    renderer.group_text_for_pdf = true;
+    renderer.begin_page(800.0, 600.0);
+    renderer.draw_text("예)\t세금을 받치다.", 10.0, 20.0, &TextStyle::default());
+    let output = renderer.output();
+    assert!(output.contains(">예)</text>"));
+    assert!(output.contains(">세금을 받치다.</text>"));
+    assert!(!output.contains(">세</text>"));
+}
+
