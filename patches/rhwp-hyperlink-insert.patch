+fn assert_body_hyperlink(label: &str, doc: &HwpDocument, url: &str, display_text: &str) {
+    use crate::model::control::{Control, FieldType};
+
+    let para = &doc.document.sections[0].paragraphs[0];
+    let (range, field) = para
+        .field_ranges
+        .iter()
+        .find_map(|range| match para.controls.get(range.control_idx) {
+            Some(Control::Field(field)) if field.field_type == FieldType::Hyperlink => {
+                Some((range, field))
+            }
+            _ => None,
+        })
+        .expect("HYPERLINK Field + FieldRange");
+    let visible: String = para
+        .text
+        .chars()
+        .skip(range.start_char_idx)
+        .take(range.end_char_idx - range.start_char_idx)
+        .collect();
+    assert_eq!(visible, display_text, "{label}: visible text range");
+    assert_eq!(field.command, url, "{label}: URL command");
+    assert_eq!(field.ctrl_id, crate::parser::tags::FIELD_HYPERLINK);
+    assert_ne!(field.field_id, 0);
+}
