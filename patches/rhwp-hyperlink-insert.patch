+#[test]
+fn hop_insert_hyperlink_survives_hwp_and_hwpx_roundtrips() {
+    let url = "https://example.com/docs?q=한글&mode=full";
+    let display_text = "한글 링크 열기";
+    let mut doc = HwpDocument::create_empty();
+
+    let result = doc
+        .insert_hyperlink_at(0, 0, 0, url, display_text)
+        .expect("하이퍼링크 삽입");
+    let result: Value = serde_json::from_str(&result).expect("삽입 결과 JSON");
+    assert_eq!(result["ok"], true);
+    assert_eq!(result["startOffset"], 0);
+    assert_eq!(result["charOffset"], display_text.chars().count() as u64);
+    assert_body_hyperlink("live", &doc, url, display_text);
+
+    let hwp = doc
+        .export_hwp_with_adapter_snapshot()
+        .expect("하이퍼링크 포함 HWP 저장");
+    let hwp_reopened = HwpDocument::from_bytes(&hwp).expect("HWP 재열기");
+    assert_body_hyperlink("hwp", &hwp_reopened, url, display_text);
+
+    let hwpx = doc.export_hwpx_native().expect("하이퍼링크 포함 HWPX 저장");
+    let hwpx_reopened = HwpDocument::from_bytes(&hwpx).expect("HWPX 재열기");
+    assert_body_hyperlink("hwpx", &hwpx_reopened, url, display_text);
+}
