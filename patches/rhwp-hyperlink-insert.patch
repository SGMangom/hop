+#[test]
+fn hop_insert_hyperlink_rejects_empty_payloads_without_mutation() {
+    let mut doc = HwpDocument::create_empty();
+    let before = doc.document.sections[0].paragraphs[0].clone();
+    assert!(doc.insert_hyperlink_at(0, 0, 0, "", "표시").is_err());
+    assert!(doc
