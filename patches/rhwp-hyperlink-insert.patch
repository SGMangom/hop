+fn insert_hyperlink_field_in_para(
+    para: &mut Paragraph,
+    char_offset: usize,
+    field_id: u32,
+    url: &str,
+    display_text: &str,
+) -> Result<(usize, usize, usize), HwpError> {
+    let text_len = para.text.chars().count();
+    let requested_start = char_offset.min(text_len);
+    if para
+        .field_ranges
+        .iter()
+        .any(|range| requested_start > range.start_char_idx && requested_start < range.end_char_idx)
+    {
+        return Err(HwpError::InvalidField(
+            "기존 필드 내부에는 하이퍼링크를 중첩할 수 없습니다".into(),
+        ));
+    }
+
+    let start = para.insert_text_at(requested_start, display_text);
+    let end = start.saturating_add(display_text.chars().count());
+    let positions = para.control_text_positions();
+    let insert_idx = positions
+        .iter()
+        .position(|&pos| pos > start)
+        .unwrap_or(para.controls.len());
+
+    for range in &mut para.field_ranges {
+        if range.control_idx >= insert_idx {
+            range.control_idx += 1;
+        }
+    }
+
+    let field = Field {
+        field_type: FieldType::Hyperlink,
+        command: url.to_string(),
+        properties: 0,
+        extra_properties: 0,
+        field_id,
+        ctrl_id: tags::FIELD_HYPERLINK,
+        instance_id: Some(field_id),
+        ctrl_data_name: None,
+        memo_index: 0,
+        memo_paragraphs: Vec::new(),
+        memo_text_direction: None,
+        raw_parameters_xml: None,
+        parameters: Default::default(),
+        guide_residue: None,
+    };
+
+    para.align_ctrl_data_records();
+    para.controls.insert(insert_idx, Control::Field(field));
+    para.ctrl_data_records.insert(insert_idx, None);
+
+    let new_range = FieldRange {
+        start_char_idx: start,
+        end_char_idx: end,
+        control_idx: insert_idx,
+        end_field_id: field_id,
+    };
+    let range_idx = para
+        .field_ranges
+        .iter()
+        .position(|range| {
+            range.start_char_idx > start
+                || (range.start_char_idx == start && range.control_idx > insert_idx)
+        })
+        .unwrap_or(para.field_ranges.len());
+    para.field_ranges.insert(range_idx, new_range);
+    rebuild_char_offsets(para);
+
+    Ok((start, end, insert_idx))
+}
