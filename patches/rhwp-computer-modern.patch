+// Match the exact packaged outlines used by layout even when no CM font is installed.
+fn computer_modern_typeface(font_mgr: &FontMgr, italic: bool, bold: bool) -> skia_safe::Typeface {
+    thread_local! {
+        static FACES: std::cell::OnceCell<[skia_safe::Typeface; 3]> = const { std::cell::OnceCell::new() };
+    }
+    FACES.with(|cache| {
+        let faces = cache.get_or_init(|| [
+            font_mgr.new_from_data(include_bytes!("../../../assets/fonts/computer-modern/ComputerModern-Regular.ttf"), None).expect("bundled CM Regular"),
+            font_mgr.new_from_data(include_bytes!("../../../assets/fonts/computer-modern/ComputerModern-Italic.ttf"), None).expect("bundled CM Italic"),
+            font_mgr.new_from_data(include_bytes!("../../../assets/fonts/computer-modern/ComputerModern-Bold.ttf"), None).expect("bundled CM Bold"),
+        ]);
+        faces[if bold { 2 } else if italic { 1 } else { 0 }].clone()
+    })
 }

