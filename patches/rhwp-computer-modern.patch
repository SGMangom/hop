+//! Advance and ink bounds from the same original Computer Modern faces used to draw equations.
+use std::sync::OnceLock;
+use ttf_parser::Face;
+
+const REGULAR: &[u8] = include_bytes!("../../../assets/fonts/computer-modern/ComputerModern-Regular.ttf");
+const ITALIC: &[u8] = include_bytes!("../../../assets/fonts/computer-modern/ComputerModern-Italic.ttf");
+const BOLD: &[u8] = include_bytes!("../../../assets/fonts/computer-modern/ComputerModern-Bold.ttf");
+
+pub(crate) fn face(italic: bool, bold: bool) -> &'static Face<'static> {
+    static FACES: OnceLock<[Face<'static>; 3]> = OnceLock::new();
+    let faces = FACES.get_or_init(|| [
+        Face::parse(REGULAR, 0).expect("bundled Computer Modern Regular"),
+        Face::parse(ITALIC, 0).expect("bundled Computer Modern Italic"),
+        Face::parse(BOLD, 0).expect("bundled Computer Modern Bold"),
+    ]);
+    &faces[if bold { 2 } else if italic { 1 } else { 0 }]
+}
+
+pub(crate) struct TextMetrics {
+    pub width: f64,
+    pub ascent: f64,
+    pub descent: f64,
+    /// Add to the layout box origin before drawing; includes negative left bearing.
+    pub left_pad: f64,
+}
+
+pub(crate) fn has_cjk(text: &str) -> bool {
+    text.chars().any(|c| matches!(c,
+        '\u{3000}'..='\u{9FFF}' | '\u{F900}'..='\u{FAFF}' | '\u{AC00}'..='\u{D7AF}'))
+}
+
+pub(crate) fn text_metrics(text: &str, fs: f64, italic: bool, bold: bool) -> TextMetrics {
+    let face = face(italic, bold);
+    let scale = fs / f64::from(face.units_per_em());
+    let (mut pen, mut left, mut right, mut ascent, mut descent) = (0.0_f64, 0.0_f64, 0.0_f64, 0.0_f64, 0.0_f64);
+    for ch in text.chars() {
+        if let Some(id) = face.glyph_index(ch) {
+            if let Some(ink) = face.glyph_bounding_box(id) {
+                left = left.min(pen + f64::from(ink.x_min) * scale);
+                right = right.max(pen + f64::from(ink.x_max) * scale);
+                ascent = ascent.max(f64::from(ink.y_max) * scale);
+                descent = descent.max(-f64::from(ink.y_min) * scale);
+            }
+            pen += f64::from(face.glyph_hor_advance(id).unwrap_or(face.units_per_em())) * scale;
+        } else {
+            // ponytail: unsupported glyphs use a conservative em box; embed the fallback
+            // face before promising exact metrics for CJK or arbitrary Unicode text.
+            pen += fs;
+            ascent = ascent.max(fs);
+            descent = descent.max(fs * 0.25);
+        }
+    }
+    TextMetrics { width: right.max(pen) - left, ascent, descent, left_pad: -left }
+}
+
+/// Match the renderer's natural round glyph / stretched path choice.
+pub(crate) fn delimiter_width(symbol: &str, fs: f64, body_height: f64) -> f64 {
+    if symbol.is_empty() { 0.0 }
+    else if body_height <= fs * 1.2 && matches!(symbol, "(" | ")") {
+        text_metrics(symbol, fs, false, false).width
+    } else { fs * 0.27 }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn computer_modern_advance_and_ink_are_contained() {
+        for (text, italic) in [("m", true), ("f", true), ("j", true), ("ψ", false), ("ℏ", false), ("∇", false), ("∫", false)] {
+            let m = text_metrics(text, 20.0, italic, false);
+            let f = face(italic, false);
+            let id = f.glyph_index(text.chars().next().unwrap()).unwrap();
+            let ink = f.glyph_bounding_box(id).unwrap();
+            let scale = 20.0 / f64::from(f.units_per_em());
+            assert!(m.left_pad + f64::from(ink.x_min) * scale >= -1e-9, "{text} left");
+            assert!(m.left_pad + f64::from(ink.x_max) * scale <= m.width + 1e-9, "{text} right");
+            assert!(f64::from(ink.y_max) * scale <= m.ascent + 1e-9, "{text} top");
+            assert!(-f64::from(ink.y_min) * scale <= m.descent + 1e-9, "{text} bottom");
+        }
+        assert!(text_metrics("∇", 20.0, false, false).width > 16.0);
+        assert!(text_metrics("m", 20.0, true, false).width > 16.0);
+    }
+}
