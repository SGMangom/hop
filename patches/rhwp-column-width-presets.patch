+    /// 한컴의 2단 `왼쪽`/`오른쪽` 프리셋을 적용한다.
+    ///
+    /// `narrow_left=true` 이면 왼쪽 단이 좁고 오른쪽 단이 넓으며, false 이면 그 반대다.
+    /// 두 단 사이 간격은 `spacing_hu` 를 그대로 유지하고, 나머지 본문 폭을 1:2로 나눈다.
+    /// HWPX 저장은 절대 HWPUNIT 폭을 요구하므로 `proportional_widths=false` 로 기록한다.
+    /// HWP5 저장 후 재로드 시에는 같은 값들이 비례값으로 읽히지만 폭+간격의 합이 본문 폭과
+    /// 같아서 동일한 기하가 유지된다.
+    pub fn set_two_column_preset_native(
+        &mut self,
+        section_idx: usize,
+        narrow_left: bool,
+        spacing_hu: i16,
+    ) -> Result<String, HwpError> {
+        if spacing_hu < 0 {
+            return Err(HwpError::RenderError(
+                "단 간격은 음수일 수 없습니다".to_string(),
+            ));
+        }
+        let page_def = self
+            .document
+            .sections
+            .get(section_idx)
+            .ok_or_else(|| {
+                HwpError::RenderError(format!("구역 인덱스 {} 범위 초과", section_idx))
+            })?
+            .section_def
+            .page_def
+            .clone();
+        let body_width = crate::model::page::PageAreas::from_page_def(&page_def)
+            .body_area
+            .width();
+        let usable_width = body_width - i32::from(spacing_hu);
+        if usable_width < 3 {
+            return Err(HwpError::RenderError(
+                "본문 폭이 2단 프리셋을 적용하기에 너무 좁습니다".to_string(),
+            ));
+        }
+
+        let narrow_width = usable_width / 3;
+        let wide_width = usable_width - narrow_width;
+        if narrow_width > i16::MAX as i32 || wide_width > i16::MAX as i32 {
+            return Err(HwpError::RenderError(
+                "현재 용지 폭은 개별 단 너비의 HWP 저장 범위를 넘습니다".to_string(),
+            ));
+        }
+        let (left_width, right_width) = if narrow_left {
+            (narrow_width as i16, wide_width as i16)
+        } else {
+            (wide_width as i16, narrow_width as i16)
+        };
+
+        // 기존 생성/탐색 계약을 재사용한 뒤 개별 폭만 채운다. 명시 프리셋이므로 원본 attr 은
+        // 버려 serializer 가 same_width=false/column_count=2 를 현재 IR에서 재구성하게 한다.
+        self.set_column_def_native(section_idx, 2, 0, false, spacing_hu)?;
+        {
+            let section = &mut self.document.sections[section_idx];
+            let column_def = section
+                .paragraphs
+                .iter_mut()
+                .flat_map(|para| para.controls.iter_mut())
+                .find_map(|ctrl| match ctrl {
+                    Control::ColumnDef(cd) => Some(cd),
+                    _ => None,
+                })
+                .ok_or_else(|| {
+                    HwpError::RenderError("2단 프리셋용 ColumnDef 생성에 실패했습니다".to_string())
+                })?;
+            column_def.column_count = 2;
+            column_def.same_width = false;
+            column_def.spacing = spacing_hu;
+            column_def.widths = vec![left_width, right_width];
+            column_def.gaps = vec![spacing_hu, 0];
+            column_def.proportional_widths = false;
+            column_def.raw_attr = 0;
+            section.raw_stream = None;
+        }
+        self.rebuild_section(section_idx);
+
+        Ok(format!(
+            "{{\"ok\":true,\"leftWidth\":{},\"rightWidth\":{},\"spacing\":{}}}",
+            left_width, right_width, spacing_hu
+        ))
+    }
