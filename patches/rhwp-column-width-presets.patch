+    #[test]
+    fn two_column_left_right_presets_are_mirrored_and_roundtrip() {
+        let mut core = DocumentCore::new_empty();
+        core.create_blank_document_native().unwrap();
+        let spacing = 2268i16;
+
+        let left_result = core
+            .set_two_column_preset_native(0, true, spacing)
+            .expect("left preset");
+        assert!(left_result.contains("\"ok\":true"));
+        let left = DocumentCore::find_initial_column_def(&core.document.sections[0].paragraphs);
+        assert_eq!(left.column_count, 2);
+        assert!(!left.same_width);
+        assert_eq!(left.gaps, vec![spacing, 0]);
+        assert!(!left.proportional_widths);
+        assert_eq!(left.widths.len(), 2);
+        assert!(left.widths[0] < left.widths[1], "왼쪽 프리셋은 왼쪽 단이 좁아야 함");
+        let left_widths = left.widths.clone();
+
+        core.set_two_column_preset_native(0, false, spacing)
+            .expect("right preset");
+        let right = DocumentCore::find_initial_column_def(&core.document.sections[0].paragraphs);
+        assert_eq!(right.widths, vec![left_widths[1], left_widths[0]]);
+        assert_eq!(right.gaps, vec![spacing, 0]);
+        assert!(right.widths[0] > right.widths[1], "오른쪽 프리셋은 오른쪽 단이 좁아야 함");
+
+        // 왼쪽 프리셋을 저장 기준으로 고정하고 HWP/HWPX 양쪽 왕복을 확인한다.
+        core.set_two_column_preset_native(0, true, spacing)
+            .expect("left preset again");
+        let expected = DocumentCore::find_initial_column_def(&core.document.sections[0].paragraphs);
+
+        let hwp = core.export_hwp_with_adapter_snapshot().expect("export hwp");
+        let reopened_hwp = DocumentCore::from_bytes(&hwp).expect("reopen hwp");
+        let hwp_columns = DocumentCore::find_initial_column_def(
+            &reopened_hwp.document.sections[0].paragraphs,
+        );
+        assert_eq!(hwp_columns.widths, expected.widths);
+        assert_eq!(hwp_columns.gaps, expected.gaps);
+        assert!(hwp_columns.proportional_widths, "HWP5 unequal columns parse as proportional values");
+
+        let hwpx = core.export_hwpx_native().expect("export hwpx");
+        let reopened_hwpx = DocumentCore::from_bytes(&hwpx).expect("reopen hwpx");
+        let hwpx_columns = DocumentCore::find_initial_column_def(
+            &reopened_hwpx.document.sections[0].paragraphs,
+        );
+        assert_eq!(hwpx_columns.widths, expected.widths);
+        assert_eq!(hwpx_columns.gaps, expected.gaps);
+        assert!(!hwpx_columns.proportional_widths, "HWPX unequal columns keep absolute HWPUNIT widths");
+    }
