diff --git a/src/document_core/legacy_import.rs b/src/document_core/legacy_import.rs
new file mode 100644
index 0000000..377d225
--- /dev/null
+++ b/src/document_core/legacy_import.rs
@@ -0,0 +1,214 @@
+use crate::model::control::{Control, Field, FieldType};
+use crate::model::document::Document;
+use crate::model::paragraph::{FieldRange, Paragraph};
+use crate::parser::tags;
+
+/// Lower HWP3's legacy `Control::Hyperlink` objects into the native editable field model.
+///
+/// HWP3 keeps the URL/display text on the object control itself. HWP5/HWPX represent a
+/// hyperlink as `Field(HYPERLINK)` plus a visible text range, so leaving the legacy variant
+/// in the editable IR makes both serializers drop it. This import-boundary normalization
+/// makes the conversion once and lets every later edit/save reuse the normal field path.
+pub(crate) fn canonicalize_hwp3_hyperlinks(document: &mut Document) {
+    let mut next_field_id = max_field_id(document).saturating_add(1).max(1);
+    for section in &mut document.sections {
+        canonicalize_paragraphs(&mut section.paragraphs, &mut next_field_id);
+    }
+}
+
+fn canonicalize_paragraphs(paragraphs: &mut [Paragraph], next_field_id: &mut u32) {
+    for paragraph in paragraphs {
+        canonicalize_paragraph(paragraph, next_field_id);
+        for control in &mut paragraph.controls {
+            canonicalize_control_children(control, next_field_id);
+        }
+    }
+}
+
+fn canonicalize_control_children(control: &mut Control, next_field_id: &mut u32) {
+    match control {
+        Control::Table(table) => {
+            for cell in &mut table.cells {
+                canonicalize_paragraphs(&mut cell.paragraphs, next_field_id);
+            }
+            if let Some(caption) = &mut table.caption {
+                canonicalize_paragraphs(&mut caption.paragraphs, next_field_id);
+            }
+        }
+        Control::Shape(shape) => canonicalize_shape(shape, next_field_id),
+        Control::Picture(picture) => {
+            if let Some(caption) = &mut picture.caption {
+                canonicalize_paragraphs(&mut caption.paragraphs, next_field_id);
+            }
+        }
+        Control::Header(header) => canonicalize_paragraphs(&mut header.paragraphs, next_field_id),
+        Control::Footer(footer) => canonicalize_paragraphs(&mut footer.paragraphs, next_field_id),
+        Control::Footnote(note) => canonicalize_paragraphs(&mut note.paragraphs, next_field_id),
+        Control::Endnote(note) => canonicalize_paragraphs(&mut note.paragraphs, next_field_id),
+        Control::HiddenComment(comment) => {
+            canonicalize_paragraphs(&mut comment.paragraphs, next_field_id)
+        }
+        Control::Field(field) => canonicalize_paragraphs(&mut field.memo_paragraphs, next_field_id),
+        _ => {}
+    }
+}
+
+fn canonicalize_shape(shape: &mut crate::model::shape::ShapeObject, next_field_id: &mut u32) {
+    if let Some(drawing) = shape.drawing_mut() {
+        if let Some(text_box) = &mut drawing.text_box {
+            canonicalize_paragraphs(&mut text_box.paragraphs, next_field_id);
+        }
+    }
+    match shape {
+        crate::model::shape::ShapeObject::Group(group) => {
+            if let Some(caption) = &mut group.caption {
+                canonicalize_paragraphs(&mut caption.paragraphs, next_field_id);
+            }
+            for child in &mut group.children {
+                canonicalize_shape(child, next_field_id);
+            }
+        }
+        crate::model::shape::ShapeObject::Picture(picture) => {
+            if let Some(caption) = &mut picture.caption {
+                canonicalize_paragraphs(&mut caption.paragraphs, next_field_id);
+            }
+        }
+        _ => {}
+    }
+}
+
+fn canonicalize_paragraph(paragraph: &mut Paragraph, next_field_id: &mut u32) {
+    let positions = paragraph.control_text_positions();
+    let mut legacy = paragraph
+        .controls
+        .iter()
+        .enumerate()
+        .filter_map(|(control_idx, control)| match control {
+            Control::Hyperlink(link) => Some((
+                control_idx,
+                positions
+                    .get(control_idx)
+                    .copied()
+                    .unwrap_or_else(|| paragraph.text.chars().count()),
+                link.clone(),
+            )),
+            _ => None,
+        })
+        .collect::<Vec<_>>();
+    if legacy.is_empty() {
+        return;
+    }
+
+    // Edit from right to left so replacing one marker with its display text does not move
+    // the stored character positions of hyperlinks that still need to be converted.
+    legacy.sort_by_key(|(control_idx, pos, _)| (*pos, *control_idx));
+    for (control_idx, pos, link) in legacy.into_iter().rev() {
+        let text_len = paragraph.text.chars().count();
+        let start = pos.min(text_len);
+        if paragraph.text.chars().nth(start) == Some('\u{FFFC}') {
+            paragraph.delete_text_at(start, 1);
+        }
+        let start = paragraph.insert_text_at(start, &link.text);
+        let end = start.saturating_add(link.text.chars().count());
+        let field_id = *next_field_id;
+        *next_field_id = next_field_id.saturating_add(1).max(1);
+
+        paragraph.align_ctrl_data_records();
+        paragraph.controls[control_idx] = Control::Field(Field {
+            field_type: FieldType::Hyperlink,
+            command: link.url,
+            properties: 0,
+            extra_properties: 0,
+            field_id,
+            ctrl_id: tags::FIELD_HYPERLINK,
+            instance_id: Some(field_id),
+            ctrl_data_name: None,
+            memo_index: 0,
+            memo_paragraphs: Vec::new(),
+            memo_text_direction: None,
+            raw_parameters_xml: None,
+            parameters: Default::default(),
+            guide_residue: None,
+        });
+        if control_idx < paragraph.ctrl_data_records.len() {
+            paragraph.ctrl_data_records[control_idx] = None;
+        }
+        paragraph.field_ranges.push(FieldRange {
+            start_char_idx: start,
+            end_char_idx: end,
+            control_idx,
+            end_field_id: field_id,
+        });
+    }
+
+    paragraph
+        .field_ranges
+        .sort_by_key(|range| (range.start_char_idx, range.end_char_idx, range.control_idx));
+    crate::document_core::queries::field_query::rebuild_char_offsets(paragraph);
+}
+
+fn max_field_id(document: &Document) -> u32 {
+    let mut max_id = 0;
+    for section in &document.sections {
+        collect_max_field_id(&section.paragraphs, &mut max_id);
+    }
+    max_id
+}
+
+fn collect_max_field_id(paragraphs: &[Paragraph], max_id: &mut u32) {
+    for paragraph in paragraphs {
+        for control in &paragraph.controls {
+            match control {
+                Control::Field(field) => {
+                    *max_id = (*max_id).max(field.field_id);
+                    collect_max_field_id(&field.memo_paragraphs, max_id);
+                }
+                Control::Table(table) => {
+                    for cell in &table.cells {
+                        collect_max_field_id(&cell.paragraphs, max_id);
+                    }
+                    if let Some(caption) = &table.caption {
+                        collect_max_field_id(&caption.paragraphs, max_id);
+                    }
+                }
+                Control::Shape(shape) => collect_max_field_id_shape(shape, max_id),
+                Control::Picture(picture) => {
+                    if let Some(caption) = &picture.caption {
+                        collect_max_field_id(&caption.paragraphs, max_id);
+                    }
+                }
+                Control::Header(header) => collect_max_field_id(&header.paragraphs, max_id),
+                Control::Footer(footer) => collect_max_field_id(&footer.paragraphs, max_id),
+                Control::Footnote(note) => collect_max_field_id(&note.paragraphs, max_id),
+                Control::Endnote(note) => collect_max_field_id(&note.paragraphs, max_id),
+                Control::HiddenComment(comment) => {
+                    collect_max_field_id(&comment.paragraphs, max_id)
+                }
+                _ => {}
+            }
+        }
+    }
+}
+fn collect_max_field_id_shape(shape: &crate::model::shape::ShapeObject, max_id: &mut u32) {
+    if let Some(drawing) = shape.drawing() {
+        if let Some(text_box) = &drawing.text_box {
+            collect_max_field_id(&text_box.paragraphs, max_id);
+        }
+    }
+    match shape {
+        crate::model::shape::ShapeObject::Group(group) => {
+            if let Some(caption) = &group.caption {
+                collect_max_field_id(&caption.paragraphs, max_id);
+            }
+            for child in &group.children {
+                collect_max_field_id_shape(child, max_id);
+            }
+        }
+        crate::model::shape::ShapeObject::Picture(picture) => {
+            if let Some(caption) = &picture.caption {
+                collect_max_field_id(&caption.paragraphs, max_id);
+            }
+        }
+        _ => {}
+    }
+}
