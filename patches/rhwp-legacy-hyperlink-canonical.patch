+#[test]
+fn hop_legacy_hyperlink_canonicalization_survives_hwp_and_hwpx_roundtrips() {
+    use crate::model::control::{Control, Hyperlink};
+
+    let url = "https://legacy.example/한글?q=1";
+    let display_text = "옛 링크";
+    let mut doc = HwpDocument::create_empty();
+    let para = &mut doc.document.sections[0].paragraphs[0];
+    para.text = "앞\u{FFFC}뒤".to_string();
+    para.char_offsets = vec![0, 1, 2];
+    para.char_count = 4;
+    para.controls.push(Control::Hyperlink(Hyperlink {
+        url: url.to_string(),
+        text: display_text.to_string(),
+    }));
+    para.ctrl_data_records.push(None);
+
+    crate::document_core::legacy_import::canonicalize_hwp3_hyperlinks(&mut doc.document);
+    let para = &doc.document.sections[0].paragraphs[0];
+    assert_eq!(para.text, format!("앞{display_text}뒤"));
+    assert!(
+        para.controls
+            .iter()
+            .all(|control| !matches!(control, Control::Hyperlink(_))),
+        "editable IR must not retain legacy Hyperlink controls"
+    );
+    assert_body_hyperlink("canonical", &doc, url, display_text);
+    let range = para.field_ranges.first().expect("canonical field range");
+    assert_eq!(range.start_char_idx, 1, "legacy object position is preserved");
+
+    let hwp = doc
+        .export_hwp_with_adapter_snapshot()
+        .expect("legacy hyperlink 포함 HWP 저장");
+    let hwp_reopened = HwpDocument::from_bytes(&hwp).expect("HWP 재열기");
+    assert_body_hyperlink("legacy-hwp", &hwp_reopened, url, display_text);
+
+    let hwpx = doc
+        .export_hwpx_native()
+        .expect("legacy hyperlink 포함 HWPX 저장");
+    let hwpx_reopened = HwpDocument::from_bytes(&hwpx).expect("HWPX 재열기");
+    assert_body_hyperlink("legacy-hwpx", &hwpx_reopened, url, display_text);
+}
